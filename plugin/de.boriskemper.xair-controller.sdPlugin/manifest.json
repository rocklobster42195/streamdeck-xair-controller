{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "X-Air Controller",
    "Version": "0.1.0.0",
    "Author": "Boris Kemper",
    "Category": "X-Air Controller",
    "CategoryIcon": "imgs/plugin/category-icon",
    "CodePath": "bin/plugin.js",
    "Description": "Faders, mutes and meters of Behringer X-Air mixers (XR12, XR16, XR18) and the Midas MR18 on your Stream Deck.\nUnofficial community plugin, not affiliated with Behringer, Midas, Music Tribe or Elgato.\n\nIcons by https://pictogrammers.com",
    "Icon": "imgs/plugin/marketplace",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "12"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24",
        "Debug": "enabled"
    },
    "UUID": "de.boriskemper.xair-controller",
    "Actions": [
        {
            "Name": "Fader",
            "UUID": "de.boriskemper.xair-controller.fader-dial",
            "Icon": "imgs/actions/fader-dial/icon",
            "Tooltip": "A mixer channel on a dial: level, mute and its meter.",
            "PropertyInspectorPath": "ui/fader-dial.html",
            "Controllers": [
                "Encoder"
            ],
            "Encoder": {
                "layout": "layouts/canvas.json",
                "TriggerDescription": {
                    "Rotate": "Level",
                    "Push": "Mute",
                    "Touch": "0 dB (hold: -∞)"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/fader-dial/key"
                }
            ]
        },
        {
            "Name": "Channel",
            "UUID": "de.boriskemper.xair-controller.channel-key",
            "Icon": "imgs/actions/channel-key/icon",
            "Tooltip": "A mixer channel on a key: mute, like its scribble strip, or with its meter.",
            "PropertyInspectorPath": "ui/channel-key.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/channel-key/key"
                }
            ]
        },
        {
            "Name": "Send",
            "UUID": "de.boriskemper.xair-controller.send-dial",
            "Icon": "imgs/actions/send-dial/icon",
            "Tooltip": "A channel's send to a bus or FX on a dial.",
            "PropertyInspectorPath": "ui/send-dial.html",
            "Controllers": [
                "Encoder"
            ],
            "Encoder": {
                "layout": "layouts/canvas.json",
                "TriggerDescription": {
                    "Rotate": "Send level",
                    "Push": "Send on/off",
                    "Touch": "0 dB (hold: -∞)"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/send-dial/key"
                }
            ]
        },
        {
            "Name": "Mute Group",
            "UUID": "de.boriskemper.xair-controller.mute-group-key",
            "Icon": "imgs/actions/mute-group-key/icon",
            "Tooltip": "Switch a mute group; shows its channels.",
            "PropertyInspectorPath": "ui/mute-group-key.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/mute-group-key/key"
                }
            ]
        },
        {
            "Name": "Snapshot",
            "UUID": "de.boriskemper.xair-controller.snapshot-key",
            "Icon": "imgs/actions/snapshot-key/icon",
            "Tooltip": "Load a snapshot of the mixer.",
            "PropertyInspectorPath": "ui/snapshot-key.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/snapshot-key/key"
                }
            ]
        }
    ]
}
